# Copy to .env.production. Never commit the populated file.
# All placeholder values below must be replaced before deployment.

# Public ingress
CADDY_DOMAIN=app.example.com
CADDY_EMAIL=operations@example.com
CORS_ORIGINS=https://app.example.com
NEXT_PUBLIC_API_BASE_URL=/api/v1
ENVIRONMENT=production
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# PostgreSQL and asynchronous processing
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=replace-with-a-long-unique-database-password
DATABASE_URL=postgresql+asyncpg://documind:replace-with-a-long-unique-database-password@postgres:5432/documind
JOB_QUEUE_BACKEND=celery
CELERY_BROKER_URL=redis://redis:6379/0
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_URL=redis://redis:6379/1

# Durable private object storage (required in production)
STORAGE_BACKEND=s3
S3_BUCKET=replace-with-private-bucket-name
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=

# Vector store is private on the Compose network and requires this API key.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-a-long-unique-qdrant-api-key
QDRANT_COLLECTION=documind_chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Grounded answer generation
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35

# Authentication and operations
JWT_SECRET_KEY=replace-with-a-random-64-character-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14
REFRESH_COOKIE_SECURE=true
METRICS_TOKEN=replace-with-a-long-unique-metrics-token

# Document and processing limits
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.txt,.csv,.md
PROCESSING_LEASE_MINUTES=30
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_DISPATCH_STALE_SECONDS=300
