# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://documind:documind@postgres:5432/documind
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=change-me-in-local-env

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Uploads
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.txt,.csv,.md

# Vector indexing
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documind_chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Grounded Q&A
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35

# Auth
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14
REFRESH_COOKIE_SECURE=false

