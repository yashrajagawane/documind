# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://documind:documind@postgres:5432/documind
JOB_QUEUE_BACKEND=celery
CELERY_BROKER_URL=redis://redis:6379/0
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_URL=redis://redis:6379/1
TRUSTED_PROXY_CIDRS=
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=change-me-in-local-env

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Uploads
STORAGE_BACKEND=local
STORAGE_DIR=storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.txt,.csv,.md

# Vector indexing
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documind_chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Grounded Q&A
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35

# Auth
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14
REFRESH_COOKIE_SECURE=false

# Operations (leave blank to keep metrics unavailable)
PROCESSING_LEASE_MINUTES=30
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_DISPATCH_STALE_SECONDS=300
METRICS_TOKEN=
